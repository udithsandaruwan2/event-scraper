  },
  "devDependencies": {
    "@netlify/functions": "^4.2.5",
    "@netlify/vite-plugin": "^2.1.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
